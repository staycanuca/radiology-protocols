# ==============================================================================
# CONFIGURARE ASISTENT AI & AUTENTIFICARE (Ghidul Protocoalelor de Radiologie)
# ==============================================================================

# Cheie API Google Gemini (Opțional - fallback local inteligent disponibil)
GEMINI_API_KEY=

# Cheie API OpenAI GPT-4o (Opțional)
OPENAI_API_KEY=

# Documentare pe câmpuri în editor: folosește căutare web, fără fallback clinic offline.
# Necesită acces/cotă pentru model și instrumentul de căutare al furnizorului.
FIELD_AI_GEMINI_MODEL=gemini-3.6-flash
FIELD_AI_OPENAI_MODEL=gpt-4.1

# OAuth în editor: CLI-urile oficiale folosesc sesiunile Google/ChatGPT deja conectate.
# Opțional: model explicit; gol = modelul implicit al CLI-ului.
FIELD_AI_CODEX_MODEL=
FIELD_AI_GEMINI_CLI_MODEL=

# Client ID Google OAuth 2.0 (Opțional - pentru conectare oficială cu Google în producție)
# Obținut din Google Cloud Console -> APIs & Services -> Credentials
GOOGLE_CLIENT_ID=

# Cheie secretă sesiune Flask
FLASK_SECRET_KEY=radiology-protocols-clinical-secret-key
