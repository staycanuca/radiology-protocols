# ==============================================================================
# CONFIGURARE ASISTENT AI & AUTENTIFICARE (Ghidul Protocoalelor de Radiologie)
# ==============================================================================

# Cheie API Google Gemini (Opțional - fallback local inteligent disponibil)
GEMINI_API_KEY=

# Cheie API OpenAI GPT-4o (Opțional)
OPENAI_API_KEY=

# Client ID Google OAuth 2.0 (Opțional - pentru conectare oficială cu Google în producție)
# Obținut din Google Cloud Console -> APIs & Services -> Credentials
GOOGLE_CLIENT_ID=

# Cheie secretă sesiune Flask
FLASK_SECRET_KEY=radiology-protocols-clinical-secret-key
